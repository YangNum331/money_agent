# Optional. Raises GitHub API rate limits and enables private-repository access.
GITHUB_TOKEN=

# Optional. Only required when --evaluator llm is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# Runtime defaults
MONEY_AGENT_DB=data/money_agent.db
MONEY_AGENT_MIN_BUDGET_USD=20
MONEY_AGENT_GITHUB_MIN_STARS=10
MONEY_AGENT_GITHUB_MIN_AGE_DAYS=180
MONEY_AGENT_SCAN_INTERVAL_HOURS=6
MONEY_AGENT_DAEMON_LOG=logs/money_agent.log
MONEY_AGENT_DAEMON_PID=data/money_agent_daemon.pid
